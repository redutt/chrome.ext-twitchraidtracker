{
  "manifest_version": 3,
  "name": "Twitch Raid Tracker",
  "version": "1.1.2",
  "icons": {
    "128": "images/icon128.png",
    "48": "images/icon48.png",
    "32": "images/icon32.png",
    "16": "images/icon16.png"
  },
  "description": "Tracks raids so the user can see if and how the user got to a channel before through a raid",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*"
  ],
  "background": {
    "service_worker": "content/raid_tracker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "content/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "css": ["content/tooltip/tooltip.css"],
      "js": ["content/tooltip/tooltip.js"]
    }
  ],
  "options_ui": {
    "page": "content/options/options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": ["content/shared.js"],
      "matches": ["*://*.twitch.tv/*"]
    }
  ]
}
